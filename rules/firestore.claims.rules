rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function member(t) {
      return request.auth != null && t in request.auth.token.tenants;
    }
    match /{doc=**} {
      allow read, delete: if member(resource.data.tenantId);
      allow create: if member(request.resource.data.tenantId)
        && request.resource.id.matches(request.resource.data.tenantId + '__.+');
      allow update: if member(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
    }
  }
}
